{
  "name": "@exiledata/cli",
  "version": "0.0.0",
  "private": true,
  "description": "ExileData developer/data operations CLI",
  "type": "module",
  "bin": {
    "exiledata": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@exiledata/ingestion-common": "workspace:*",
    "@exiledata/ingestion-poe2": "workspace:*",
    "@exiledata/schema": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
