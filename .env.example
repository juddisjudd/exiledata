# ExileData — Environment configuration example
# Copy to .env and fill in values. Never commit .env with real secrets.

# Application
NODE_ENV=development
LOG_LEVEL=info

# apps/api
API_PORT=3000
API_BASE_URL=http://localhost:3000

# PostgreSQL (application/service state: API clients, keys, dataset metadata, usage)
DATABASE_URL=postgresql://exiledata:exiledata@localhost:5432/exiledata

# Authentication
# Secret used to hash/sign API keys. Generate a long random value for real environments.
API_KEY_SECRET=change-me-in-production

# Rate limiting (requests per window, per API key)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Dataset storage
# "local" (filesystem, for development) or "r2" (Cloudflare R2, for production).
# See ingestion/common/src/storage for the DatasetStorage drivers this selects between.
DATASET_STORAGE_DRIVER=local
DATASET_STORAGE_PATH=./data/fixtures

# R2 (S3-compatible) — only used when DATASET_STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=exiledata-datasets
