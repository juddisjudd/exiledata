# ExileData — Environment configuration example
# Copy to .env and fill in values. Never commit .env with real secrets.

# Application
NODE_ENV=development
LOG_LEVEL=info

# apps/api
API_PORT=3000

# PostgreSQL (application/service state: API clients, keys, usage)
DATABASE_URL=postgresql://exiledata:exiledata@localhost:5432/exiledata

# Authentication
# HMAC key for stored API key hashes. Generate a long random value for real environments.
# Changing it invalidates every issued key.
API_KEY_SECRET=change-me-in-production

# Bearer token for the admin API and the dashboard at /admin. At least 32 characters.
# Leave empty to disable admin routes (they answer 503).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# Rate limit given to a new API key when none is chosen (requests per minute)
DEFAULT_RATE_LIMIT_PER_MINUTE=120

# CLI: API that `exiledata keys ...` talks to. Defaults to https://api.exiledata.dev.
# EXILEDATA_API_URL=http://localhost:3000

# Dataset storage
# "local" (filesystem, for development) or "r2" (Cloudflare R2, for production).
# See packages/storage for the DatasetStorage drivers this selects between.
DATASET_STORAGE_DRIVER=local
DATASET_STORAGE_PATH=./data/datasets

# R2 (S3-compatible) — only used when DATASET_STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=exiledata-datasets
