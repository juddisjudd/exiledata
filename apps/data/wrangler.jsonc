{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "exiledata-data",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-03",
  // The worker only builds keys under downloads/; the API's private datasets share the bucket.
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "exiledata-datasets" }]
}
