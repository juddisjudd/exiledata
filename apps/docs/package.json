{
  "name": "@exiledata/docs",
  "version": "0.0.0",
  "private": true,
  "description": "ExileData documentation site: markdown pages plus an API reference generated from the OpenAPI document",
  "type": "module",
  "scripts": {
    "build": "tsx src/cli.ts build",
    "dev": "tsx watch src/cli.ts dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "marked": "^18.0.13",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.129.0"
  }
}
