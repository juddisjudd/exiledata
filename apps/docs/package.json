{
  "name": "@exiledata/docs",
  "version": "0.0.0",
  "private": true,
  "description": "ExileData documentation application (API, SDK, schema, datasets, auth, versioning, changelogs, ingestion sources)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.129.0"
  }
}
