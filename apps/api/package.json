{
  "name": "@exiledata/api",
  "version": "0.0.0",
  "private": true,
  "description": "ExileData HTTP API",
  "type": "module",
  "main": "./dist/server.js",
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@exiledata/schema": "workspace:*",
    "@exiledata/storage": "workspace:*",
    "@exiledata/types": "workspace:*",
    "fastify": "^5.2.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
