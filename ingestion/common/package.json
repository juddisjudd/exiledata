{
  "name": "@exiledata/ingestion-common",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ingestion pipeline interfaces: source -> parser -> normalized model -> validator -> dataset",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@exiledata/schema": "workspace:*",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
