{
  "name": "@exiledata/ingestion-poe2",
  "version": "0.0.0",
  "private": true,
  "description": "PoE 2 ingestion from GGPK extracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
